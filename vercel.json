{
  "version": 2,
  "functions": {
    "backend/server.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/accounts/:path*",
      "destination": "/backend/server.ts"
    },
    {
      "source": "/api-docs/:path*",
      "destination": "/backend/server.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

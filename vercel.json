{
  "version": 2,
  "rewrites": [
    {
      "source": "/accounts",
      "destination": "/api"
    },
    {
      "source": "/accounts/:path*",
      "destination": "/api"
    },
    {
      "source": "/api-docs",
      "destination": "/api"
    },
    {
      "source": "/api-docs/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
